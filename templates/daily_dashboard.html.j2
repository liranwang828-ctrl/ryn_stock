          <button class="console-tab-btn" onclick="switchConsoleTab('scan', this)" id="console-tab-scan" style="flex:1; padding: 4px 6px; font-size:0.72rem; border-radius:4px; font-weight:700; transition:all 0.2s;">🔍 自动扫股</button>
