          <button class="console-tab-btn" onclick="switchConsoleTab('backtest', this)" id="console-tab-backtest" style="flex:1; padding: 4px 6px; font-size:0.72rem; border-radius:4px; font-weight:700; transition:all 0.2s;">📊 沙盒回测</button>
