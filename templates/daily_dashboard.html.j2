            </div>
          </div>
          
          <!-- 回测时长与滑动窗口双 Slider -->
          <div style="display:grid; grid-template-columns: 1fr 1fr; gap:10px; margin-bottom: 1.25rem; background:rgba(255,255,255,0.02); padding:10px; border-radius:8px; border:1px solid rgba(255,255,255,0.04);">
            <div class="slider-group" style="margin-bottom:0; padding:0; border:none; background:none;">
              <div class="slider-header" style="margin-bottom:2px;">
                <span class="slider-label" style="font-size:0.7rem; color:var(--text-secondary);">回测时长 (Years)</span>
                <span id="val-bt-years" class="slider-value" style="font-size:0.7rem; color:#60a5fa; font-weight:700;">5年</span>
              </div>
              <input type="range" id="slide-bt-years" min="1" max="5" value="5" style="height:4px;" oninput="document.getElementById('val-bt-years').innerText=this.value+'年'">
            </div>
            <div class="slider-group" style="margin-bottom:0; padding:0; border:none; background:none;">
              <div class="slider-header" style="margin-bottom:2px;">
                <span class="slider-label" style="font-size:0.7rem; color:var(--text-secondary);">滑动窗口 (Window)</span>
                <span id="val-bt-window" class="slider-value" style="font-size:0.7rem; color:#60a5fa; font-weight:700;">60天</span>
              </div>
              <input type="range" id="slide-bt-window" min="30" max="120" step="10" value="60" style="height:4px;" oninput="document.getElementById('val-bt-window').innerText=this.value+'天'">
            </div>
          </div>
          
          <!-- 1. VIX 限额 -->
          <div class="slider-group">
            <div class="slider-header">
              <span class="slider-label" title="VIX高于此值系统将强制阻断多头交易，转为防守态势">VIX 恐慌阀门 (VIX Veto Threshold)</span>
              <span id="val-vix" class="slider-value">25</span>
            </div>
            <input type="range" id="slide-vix" min="15" max="35" value="25" oninput="updateSliderVal('vix', this.value)">
          </div>
          
          <!-- 2. SPY 200均线距离 -->
