              alert(symbol + " 已从今日关注中移出。");
              location.reload();
            } else {
              alert("移出今日关注失败: " + data.error);
            }
          })
          .catch(err => {
            alert("请求发送失败: " + err);
          });
      } catch (err) {
        console.error('Error in removeFromFocus:', err);
      }
    }

    function removeFromWatchlist(symbol) {
      try {
        if (!confirm("确定要将 " + symbol + " 从自选股及监控轮询中完全移出吗？")) {
          return;
        }
        fetch('/api/remove_watchlist?symbol=' + symbol)
          .then(res => res.json())
          .then(data => {
            if (data.status === 'success') {
              alert(symbol + " 已从自选股及轮询中完全移出。");
              location.reload();
            } else {
              alert("移出自选股失败: " + data.error);
            }
          })
          .catch(err => {
            alert("请求发送失败: " + err);
          });
      } catch (err) {
        console.error('Error in removeFromWatchlist:', err);
      }
    }

    // 手工输入关注股并触发实时轮询绑定
    function searchAndAddFocus() {
      try {
        const input = document.getElementById('manual-focus-input');
        const symbol = input ? input.value.trim().toUpperCase() : '';
        if (!symbol) {
          alert('请输入股票代码！');
          return;
        }
        addToFocus(symbol);
      } catch (err) {
        console.error('Error in searchAndAddFocus:', err);
      }
    }

    // 联动今日关注股票智能生成 CIO 深度研判报告
    function generateReportForFocus(symbol) {
      try {
        // 直接触发任务运行并开启滑出日志抽屉
        runTask('cio_' + symbol);
      } catch (err) {
        console.error('Error in generateReportForFocus:', err);
      }
    }


    function addToWatchlist(symbol) {
      try {
        const btnOverview = document.getElementById('watch-btn-' + symbol);
        const btnIntraday = document.getElementById('watch-btn-intraday-' + symbol);
        
        const updateButtonStates = (text, className, disabled) => {
          [btnOverview, btnIntraday].forEach(btn => {
            if (btn) {
              btn.innerText = text;
              if (className) btn.className = className;
              if (disabled) btn.onclick = null;
            }
          });
        };
        
        updateButtonStates("⏳...", null, false);
        
        fetch('/api/add_watchlist?symbol=' + symbol)
          .then(res => res.json())
          .then(data => {
            if (data.status === 'success') {
              updateButtonStates("⭐ 已关注", "btn-watch-active", true);
              alert(symbol + " 已成功加入自选股，并已永久纳入盘中轮询监控列表！");
            } else {
              updateButtonStates("➕ 关注", "btn-watch", false);
              alert("添加失败: " + data.error);
            }
          })
          .catch(err => {
            updateButtonStates("➕ 关注", "btn-watch", false);
            alert("请求发送失败: " + err);
          });
      } catch (err) {
        console.error('Error in addToWatchlist:', err);
      }
    }

    // ── 录入交易相关 JavaScript 函数 ──────────────────────────────────────
    function openTradeModal() {
      const modal = document.getElementById('trade-modal');
      modal.style.display = 'flex';
      setTimeout(() => {
        modal.classList.add('active');
      }, 10);
      document.getElementById('trade-form').reset();
      setTradeAction('buy');
      document.getElementById('trade-error-msg').style.display = 'none';
    }

    function closeTradeModal() {
      const modal = document.getElementById('trade-modal');
      modal.classList.remove('active');
      setTimeout(() => {
        modal.style.display = 'none';
      }, 300);
    }

    function setTradeAction(action) {
      document.getElementById('trade-action').value = action;
      const buyBtn = document.getElementById('btn-buy-select');
      const sellBtn = document.getElementById('btn-sell-select');
      
      if (action === 'buy') {
        buyBtn.classList.add('active-buy');
        sellBtn.classList.remove('active-sell');
      } else {
        buyBtn.classList.remove('active-buy');
        sellBtn.classList.add('active-sell');
      }
    }

    async function submitTradeForm(event) {
      event.preventDefault();
      
      const symbol = document.getElementById('trade-symbol').value.trim().toUpperCase();
      const action = document.getElementById('trade-action').value;
      const shares = parseInt(document.getElementById('trade-shares').value, 10);
      const price = parseFloat(document.getElementById('trade-price').value);
      
      const stopVal = document.getElementById('trade-stop').value.trim();
      const targetVal = document.getElementById('trade-target').value.trim();
      const stop_price = stopVal ? parseFloat(stopVal) : null;
      const target_price = targetVal ? parseFloat(targetVal) : null;
      const reason = document.getElementById('trade-reason').value.trim();
      
      const errorMsgDiv = document.getElementById('trade-error-msg');
      errorMsgDiv.style.display = 'none';
      
      if (!symbol || !shares || !price) {
        errorMsgDiv.textContent = '❌ 股票代码、数量与价格为必填项。';
        errorMsgDiv.style.display = 'block';
        return;
      }

      const submitBtn = document.querySelector('button[type="submit"][form="trade-form"]') || event.target.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '⏳ 正在提交 Submitting...';
      }

      try {
        // 智能处理 file:/// 协议：若是本地静态文件打开，则将请求引向运行中的后端服务器（支持跨域）
        const serverPort = {{ server_port | default(8080) }};
        const host = (location.protocol === 'file:') ? `http://localhost:${serverPort}` : '';
        const fetchUrl = `${host}/api/record_trade`;

        const response = await fetch(fetchUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            symbol,
            action,
            shares,
            price,
            stop_price,
            target_price,
            reason
          })
        });

        const data = await response.json();
        if (response.ok && data.status === 'success') {
          closeTradeModal();
          alert(`✅ 交易记录成功！\n${action === 'buy' ? '买入' : '卖出'} ${shares} 股 ${symbol}，价格 $${price}。`);
          location.reload();
        } else {
          errorMsgDiv.textContent = `❌ ${data.error || '提交交易失败，请稍后重试。'}`;
          errorMsgDiv.style.display = 'block';
        }
      } catch (err) {
        console.error('Error recording trade:', err);
        errorMsgDiv.textContent = `❌ 连接服务器失败: ${err.message}`;
        errorMsgDiv.style.display = 'block';
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = '确认提交 Submit';
        }
      }
    }

    let masterQuotes = [];
    let currentQuoteIndex = 0;
    let quoteInterval = null;

    function initMasterQuotesCarousel() {
      try {
        const host = (location.protocol === 'file:') ? `http://localhost:${ {{ server_port | default(8080) }} }` : '';
        fetch(host + '/api/master-quotes')
          .then(res => res.json())
          .then(data => {
            if (data && data.length > 0) {
              masterQuotes = data;
              currentQuoteIndex = 0;
              renderNextQuote();
              if (quoteInterval) clearInterval(quoteInterval);
              quoteInterval = setInterval(renderNextQuote, 8000);
            }
          })
          .catch(err => console.error("Error loading master quotes:", err));
      } catch (e) {
        console.error("Error initializing quotes carousel:", e);
      }
    }

    function renderNextQuote() {
      try {
        const container = document.getElementById('master-quote-container');
        if (!container || masterQuotes.length === 0) return;
        
        container.style.opacity = 0;
        
        setTimeout(() => {
          const q = masterQuotes[currentQuoteIndex];
          const personaEl = document.getElementById('master-quote-persona');
          const badgeEl = document.getElementById('master-quote-badge');
          const symbolEl = document.getElementById('master-quote-symbol');
          const reasonEl = document.getElementById('master-quote-reason');
          
          if (personaEl) {
            personaEl.innerText = q.persona;
            if (q.persona.includes("Livermore")) personaEl.style.color = "#34d399";
            else if (q.persona.includes("Buffett")) personaEl.style.color = "#60a5fa";
            else if (q.persona.includes("Wood")) personaEl.style.color = "#f472b6";
            else if (q.persona.includes("Druckenmiller")) personaEl.style.color = "#fbbf24";
            else personaEl.style.color = "#a7f3d0";
          }
          if (badgeEl) {
            const score = q.score || 5;
            badgeEl.innerText = `${q.vote} (Score: ${score})`;
            if (q.vote.includes("买入") || q.vote.includes("做多")) {
              badgeEl.className = "badge badge-green";
            } else if (q.vote.includes("卖出") || q.vote.includes("防守")) {
              badgeEl.className = "badge badge-red";
            } else {
              badgeEl.className = "badge badge-yellow";
            }
          }
          if (symbolEl) symbolEl.innerText = q.symbol;
          if (reasonEl) reasonEl.innerText = `"${q.reason}"`;
          
          container.style.opacity = 1;
          currentQuoteIndex = (currentQuoteIndex + 1) % masterQuotes.length;
        }, 500);
      } catch (e) {
        console.error("Error rendering quote:", e);
      }
    }

    function syncMarketClock() {
      try {
        const host = (location.protocol === 'file:') ? `http://localhost:${ {{ server_port | default(8080) }} }` : '';
        fetch(host + '/api/market-clock')
          .then(res => res.json())
          .then(data => {
            if (!data || data.error) return;
            const phaseEl = document.getElementById('market-clock-phase');
            const countdownEl = document.getElementById('market-clock-countdown');
            if (phaseEl) {
              phaseEl.innerText = data.phase_label || '未知';
              let cls = 'badge badge-gray';
              if (data.phase === 'regular') cls = 'badge badge-green';
              else if (data.phase === 'premarket' || data.phase === 'postmarket') cls = 'badge badge-blue';
              else if (data.phase === 'overnight') cls = 'badge badge-yellow';
              phaseEl.className = cls;
              phaseEl.title = '北京时间 ' + (data.now_cn || '') + ' | 美东 ' + (data.now_et || '');
            }
            if (countdownEl) {
              const target = data.countdown_target === 'close' ? '收盘' : '开盘';
              countdownEl.innerText = '距' + target + ' ' + (data.countdown_human || '--');
              countdownEl.title = '下次开盘 ' + (data.next_open_et || '') + ' | 下次收盘 ' + (data.next_close_et || '');
            }
            
            // Dynamic market-aware SOP Stepper banner updates
            const bannerEl = document.getElementById('sop-guide-banner');
            const titleEl = document.getElementById('sop-guide-title');
            const textEl = document.getElementById('sop-guide-text');
            
            const oBannerEl = document.getElementById('overview-sop-guide-banner');
            const oTitleEl = document.getElementById('overview-sop-guide-title');
            const oTextEl = document.getElementById('overview-sop-guide-text');
            
            const phase = data.phase || 'closed';
            let titleText = '';
            let guideText = '';
            let alertClass = 'alert-card alert-info';
            let borderStyle = '4px solid var(--blue)';
            let bgStyle = 'rgba(59, 130, 246, 0.05)';
            
            if (phase === 'closed' || phase === 'weekend') {
              titleText = '🏠 美股已休市 (Market Closed)';
              guideText = '当前处于策略复盘与因子调优的黄金时期。建议：① 运行<b>沙盒回测</b>调优策略参数；② 运行 Step 5 进行盘后总结并确认写回[学习反思]；③ 可在下方 Step 2 提前维护关注股票，为下个交易日做盘前准备。没做的步骤（如扫描或战略合成）可以随时补做。SOP 流程图正呈现您最近一个交易日的实际完成进度。';
              alertClass = 'alert-card alert-info';
              borderStyle = '4px solid var(--blue)';
              bgStyle = 'rgba(59, 130, 246, 0.05)';
            } else if (phase === 'premarket') {
              titleText = '🌅 盘前整装待发 (Pre-Market Session)';
              guideText = '距离正式开盘还有数小时。最佳行动路径：① 启动 Step 1 运行<b>自动量化扫股</b>；② 勾选下方 Step 2 今日关注的标的并生成 CIO 研报；③ 启动 Step 3 运行<b>多Agent战略合成</b>以防大盘降级。没做的步骤可以点击启动补做。';
              alertClass = 'alert-card alert-yellow';
              borderStyle = '4px solid var(--yellow)';
              bgStyle = 'rgba(245, 158, 11, 0.05)';
            } else if (phase === 'regular') {
              titleText = '⚔️ 盘中激战正酣 (Market Regular Hours)';
              guideText = '美股实盘交易正在进行！最佳行动路径：① 确保 Step 4 运行<b>盘中高频盯盘</b>以自动捕捉高频因子波动；② 随时关注下方大师辩论心智交锋，严格遵守策略安全线；③ 发现机会可随时点击“录入交易”。若盘前工作没做完，仍可补做。';
              alertClass = 'alert-card alert-green';
              borderStyle = '4px solid var(--green)';
              bgStyle = 'rgba(16, 185, 129, 0.05)';
            } else if (phase === 'postmarket') {
              titleText = '🌆 盘后结算与总结 (Post-Market Session)';
              guideText = '今日主力交易时段已收盘。最佳行动路径：① 启动 Step 5 运行<b>收盘复盘结算</b>，计算今日组合的真实 NAV 净资产；② 查看最新成交与收益率走势，并在[学习反思]中记录交易心智。未完成的流程均可在此阶段补做。';
              alertClass = 'alert-card alert-info';
              borderStyle = '4px solid var(--blue)';
              bgStyle = 'rgba(59, 130, 246, 0.05)';
            } else {
              titleText = '🌙 夜间非交易时段 (Overnight Session)';
              guideText = '当前市场处于美东夜间隔夜休整期。建议：① 进行<b>因子策略回测</b>及历史资产波动复盘；② 提前在下方 Step 2 确认自选股与关注列表并批量生成宏观报告，为明天的战斗整装蓄能。所有流程皆支持补做。';
              alertClass = 'alert-card alert-info';
              borderStyle = '4px solid var(--blue)';
              bgStyle = 'rgba(59, 130, 246, 0.05)';
            }
            
            // Update Command Hub banner
            if (bannerEl && titleEl && textEl) {
              titleEl.innerHTML = titleText;
              textEl.innerHTML = guideText;
              bannerEl.className = alertClass;
              bannerEl.style.borderLeft = borderStyle;
              bannerEl.style.background = bgStyle;
            }
            
            // Update Overview banner
            if (oBannerEl && oTitleEl && oTextEl) {
              oTitleEl.innerHTML = titleText;
              oTextEl.innerHTML = guideText;
              oBannerEl.className = alertClass;
              oBannerEl.style.borderLeft = borderStyle;
              oBannerEl.style.background = bgStyle;
            }
          })
          .catch(err => console.error('Error syncing market clock:', err));
      } catch (err) {
        console.error('Error in syncMarketClock:', err);
      }
    }

    // 恢复状态并初始化
    (function() {
      try {
        // 初始化大师金句轮播
        initMasterQuotesCarousel();
        syncMarketClock();
        setInterval(syncMarketClock, 10000);
        
        // 初始化数据健康警告面板的显示状态
        const panel = document.getElementById('data-health-alert-panel');
        if (panel) {
          const dismissed = safeStorage.getItem('data_health_panel_dismissed') === 'true';
          if (dismissed) {
            panel.style.display = 'none';
          }
        }

        // 触发绘制组合历史资产走势图
        drawPortfolioHistoryChart();

        const saved = safeStorage.getItem(TAB_KEY) || (location.hash ? location.hash.replace('#','') : '') || 'overview';
        const pane = document.getElementById('tab-' + saved);
        if (pane) {
          document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
          pane.classList.add('active');
          
          // 激活对应按钮
          document.querySelectorAll('.tab-btn').forEach(b => {
            if (b.getAttribute('onclick') && b.getAttribute('onclick').includes("'" + saved + "'")) {
              b.classList.add('active');
            }
          });
        }

        if (saved === 'command') {
          syncStatus();
          statusSyncInterval = setInterval(syncStatus, 5000);
        } else {
          resetAutoRefresh();
        }
      } catch (err) {
        console.error('Error in page initialization IIFE:', err);
      }
      // 初始化回测沙盒显隐
      var savedTab = safeStorage.getItem('dashboard_active_tab') || 'overview';
      var bs = document.getElementById('backtest-sandbox');
      if (bs) bs.style.display = (savedTab === 'command') ? '' : 'none';
    })();

    function refreshPortfolio() {
      try {
        fetch('/api/refresh-portfolio')
          .then(res => res.json())
          .then(data => {
            if (data.error) {
              alert('刷新失败: ' + data.error);
            } else {
              alert('组合快照已刷新（NAV: $' + Number(data.total_value).toLocaleString() + '），页面将在 2 秒后自动重载');
              setTimeout(function() { location.reload(); }, 2000);
            }
          })
          .catch(function(err) {
            alert('刷新请求失败: ' + err);
          });
      } catch (err) {
        console.error('Error in refreshPortfolio:', err);
      }
    }

    function generateAllFocusReports() {
      try {
        showTab('command', document.getElementById('btn-command'));
        var terminal = document.getElementById('terminal-body');
        if (terminal) {
          terminal.innerText = '[批量生成] 正在检查关注列表...\n';
        }
        fetch('/api/generate-focus-reports')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            if (terminal) {
              if (data.started && data.started.length > 0) {
                terminal.innerText = '[批量生成] 已启动: ' + JSON.stringify(data.started) + '\n';
                data.started.forEach(function(sym) {
                  startLogPolling('cio_' + sym);
                });
              } else {
                terminal.innerText = '[批量生成] 无需操作：所有关注标的已有完整报告。\n';
              }
              if (data.skipped && data.skipped.length > 0) {
                terminal.innerText += '[跳过] 已有报告: ' + JSON.stringify(data.skipped) + '\n';
              }
            }
            var badge = document.getElementById('current-task-badge');
            if (badge) {
              badge.innerText = 'BATCH';
              badge.className = 'badge badge-blue';
            }
          })
          .catch(function(err) {
            if (terminal) {
              terminal.innerText = '[错误] 批量生成请求失败: ' + err + '\n';
            }
            console.error('Error in generateAllFocusReports:', err);
          });
      } catch (err) {
        console.error('Error in generateAllFocusReports:', err);
      }
    }

    function openTerminalDrawer(taskName) {
      try {
        const drawer = document.getElementById('terminal-drawer');
        const title = document.getElementById('terminal-drawer-title');
        const body = document.getElementById('terminal-drawer-body');
        const dot = document.getElementById('terminal-drawer-dot-status');
        
        if (title) title.innerText = "任务控制台: " + taskName;
        if (body) body.innerText = "[系统] 正在准备异步日志流...\n";
        if (dot) dot.className = "terminal-dot active";
        
        if (drawer) {
          drawer.classList.add('open');
        }
      } catch (err) {
        console.error("Error opening terminal drawer:", err);
      }
    }

    function closeTerminalDrawer() {
      try {
        const drawer = document.getElementById('terminal-drawer');
        if (drawer) {
          drawer.classList.remove('open');
        }
      } catch (err) {
        console.error("Error closing terminal drawer:", err);
      }
    }
  </script>
