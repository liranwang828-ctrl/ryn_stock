  <script>
    // ── Safe Storage Wrapper ──────────────────────────────────────────────
    const safeStorage = {
      getItem: function(key) {
        try {
          return localStorage.getItem(key);
        } catch (e) {
          console.warn("localStorage.getItem blocked or failed:", e);
          return null;
        }
      },
      setItem: function(key, val) {
        try {
          localStorage.setItem(key, val);
        } catch (e) {
          console.warn("localStorage.setItem blocked or failed:", e);
        }
      },
      removeItem: function(key) {
        try {
          localStorage.removeItem(key);
        } catch (e) {
          console.warn("localStorage.removeItem blocked or failed:", e);
        }
      }
    };

    // 自动刷新并保持当前激活的 Tab 状态
    const TAB_KEY = 'dashboard_active_tab';
    let autoRefreshTimeout = null;

    function showTab(name, btn) {
      try {
        document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        
        const pane = document.getElementById('tab-' + name);
        if (pane) pane.classList.add('active');
        if (btn) btn.classList.add('active');
        
        safeStorage.setItem(TAB_KEY, name);
        location.hash = name;

        // 如果在控制中心，关闭自动页面刷新，避免阻断操作 and 日志流
        if (name === 'command') {
          if (autoRefreshTimeout) {
            clearTimeout(autoRefreshTimeout);
            autoRefreshTimeout = null;
          }
          // 显示回测沙盒（仅控制中心）
          var bs = document.getElementById('backtest-sandbox');
          if (bs) bs.style.display = '';
          // 触发一次服务器状态同步，初始化滑块
          syncStatus();
          if (!statusSyncInterval) {
            statusSyncInterval = setInterval(syncStatus, 5000);
          }
        } else {
          if (statusSyncInterval) {
            clearInterval(statusSyncInterval);
            statusSyncInterval = null;
          }
          // 隐藏回测沙盒（离开控制中心）
          var bs = document.getElementById('backtest-sandbox');
          if (bs) bs.style.display = 'none';
          // 当离开控制中心 tab 时，暂停日志轮询，节省网络带宽与连接资源
          if (logPollInterval) {
            stopLogPolling();
          }
          resetAutoRefresh();
        }
      } catch (err) {
        console.error('Error in showTab:', err);
      }
    }

    function resetAutoRefresh() {
      try {
        if (autoRefreshTimeout) clearTimeout(autoRefreshTimeout);
        autoRefreshTimeout = setTimeout(() => {
          if (safeStorage.getItem(TAB_KEY) !== 'command') {
            // 在刷新前检查是否有后台任务正在运行，避免强行刷新中断用户监控或计算流程
            fetch('/api/status')
              .then(res => res.json())
              .then(data => {
                try {
                  let anyRunning = false;
                  if (data.running_tasks) {
                    for (const tName in data.running_tasks) {
                      if (data.running_tasks[tName] && data.running_tasks[tName].running) {
                        anyRunning = true;
                        break;
                      }
                    }
                  }
                  if (!anyRunning) {
                    location.reload();
                  } else {
                    // 如果有任务在运行，推迟 30 秒再次检测，不执行 reload
                    resetAutoRefresh();
                  }
                } catch (innerErr) {
                  console.error('Error in auto-refresh callback:', innerErr);
                  resetAutoRefresh();
                }
              })
              .catch(() => {
                // 异常降级：如果状态请求失败，出于安全考虑暂时不自动刷新
                resetAutoRefresh();
              });
          }
        }, 30000);
      } catch (err) {
        console.error('Error in resetAutoRefresh:', err);
      }
    }

    // ── Command Hub 逻辑 ──────────────────────────────────────────────────
    let activeLogPollingTask = null;
    let logPollInterval = null;
    let statusSyncInterval = null;
    let myChart = null;

    function runTask(taskName) {
      try {
        // 存储当前处于活跃状态的任务名称，用于持久化 and 自动 reconnect
        safeStorage.setItem('active_log_task', taskName);
        highlightConsoleTab(taskName);

        const badge = document.getElementById('current-task-badge');
        if (badge) {
          badge.innerText = "RUNNING";
          badge.className = "badge badge-yellow";
        }
        const dot = document.getElementById('terminal-dot-status');
        if (dot) dot.className = "terminal-dot active";
        const drawerDot = document.getElementById('terminal-drawer-dot-status');
        if (drawerDot) drawerDot.className = "terminal-dot active";
        
        const nameEl = document.getElementById('terminal-task-name');
        if (nameEl) nameEl.innerText = "task_" + taskName + ".log";
        
        const terminal = document.getElementById('terminal-body');
        if (terminal) {
          terminal.innerText = "[系统] 正在请求启动后台异步任务: " + taskName + "...\n";
        }
        const drawerTerminal = document.getElementById('terminal-drawer-body');
        if (drawerTerminal) {
          drawerTerminal.innerText = "[系统] 正在请求启动后台异步任务: " + taskName + "...\n";
        }

        // 智能无感体验：如果是 cio 生成或 premarket 等，自动滑出终端抽屉展示，不打断用户总览视角
        if (taskName.startsWith('cio_') || taskName === 'premarket' || taskName === 'generate-focus-reports') {
          openTerminalDrawer(taskName);
        }

        fetch('/api/run?task=' + taskName)
          .then(res => res.json())
          .then(data => {
            try {
              if (data.error) {
                if (terminal) terminal.innerText += "[错误] " + data.error + "\n";
                if (drawerTerminal) drawerTerminal.innerText += "[错误] " + data.error + "\n";
                const errBadge = document.getElementById('current-task-badge');
                if (errBadge) {
                  errBadge.innerText = "ERROR";
                  errBadge.className = "badge badge-red";
                }
                const errDot = document.getElementById('terminal-dot-status');
                if (errDot) errDot.className = "terminal-dot";
                const errDrawerDot = document.getElementById('terminal-drawer-dot-status');
                if (errDrawerDot) errDrawerDot.className = "terminal-dot";
              } else {
                if (terminal) terminal.innerText += "[系统] 任务启动成功！\n";
                if (drawerTerminal) drawerTerminal.innerText += "[系统] 任务启动成功！\n";
                startLogPolling(taskName);
              }
            } catch (innerErr) {
              console.error('Error in runTask callback:', innerErr);
            }
          })
          .catch(err => {
            if (terminal) terminal.innerText += "[错误] 请求发送失败: " + err + "\n";
            if (drawerTerminal) drawerTerminal.innerText += "[错误] 请求发送失败: " + err + "\n";
            const errBadge = document.getElementById('current-task-badge');
            if (errBadge) {
              errBadge.innerText = "FAILED";
              errBadge.className = "badge badge-red";
            }
          });
      } catch (err) {
        console.error('Error in runTask:', err);
      }
    }

    function runCIOTask() {
      try {
        const selectEl = document.getElementById('cio-symbol-select');
        if (!selectEl) return;
        let sym = selectEl.value;
        if (sym === '__custom__') {
          const customEl = document.getElementById('cio-custom-input');
          sym = customEl ? customEl.value.trim().toUpperCase() : '';
          if (!sym) {
            alert('请先输入有效的股票代码！');
            return;
          }
        }
        if (sym) {
          runTask('cio_' + sym);
        }
      } catch (err) {
        console.error('Error in runCIOTask:', err);
      }
    }

    function runBacktestSandbox() {
      try {
        const vixEl = document.getElementById('slide-vix');
        const ma200El = document.getElementById('slide-ma200');
        const qqq5mEl = document.getElementById('slide-qqq5m');
        const rsiEl = document.getElementById('slide-rsi');
        const minsigEl = document.getElementById('slide-minsig');
        
        const btYearsEl = document.getElementById('slide-bt-years');
        const btWindowEl = document.getElementById('slide-bt-window');

        const vix = vixEl ? vixEl.value : "N/A";
        const ma200 = ma200El ? ma200El.value : "N/A";
        const qqq5m = qqq5mEl ? qqq5mEl.value : "N/A";
        const rsi = rsiEl ? rsiEl.value : "N/A";
        const minsig = minsigEl ? minsigEl.value : "N/A";
        
        const btYears = btYearsEl ? btYearsEl.value : "5";
        const btWindow = btWindowEl ? btWindowEl.value : "60";

        // 存储当前处于活跃状态的任务名称，用于持久化 and 自动 reconnect
        safeStorage.setItem('active_log_task', 'backtest');

        const badge = document.getElementById('current-task-badge');
        if (badge) {
          badge.innerText = "RUNNING";
          badge.className = "badge badge-yellow";
        }
        const dot = document.getElementById('terminal-dot-status');
        if (dot) dot.className = "terminal-dot active";
        const nameEl = document.getElementById('terminal-task-name');
        if (nameEl) nameEl.innerText = "task_backtest.log";

        const terminal = document.getElementById('terminal-body');
        if (terminal) {
          terminal.innerText = "[沙盒] 正在加载因子参数并运行多周期历史回测策略...\n"
                             + "  - 回测年数: " + btYears + " 年\n"
                             + "  - 滑动窗口: " + btWindow + " 天\n"
                             + "  - VIX阀门: " + vix + "\n"
                             + "  - SPY MA200: " + ma200 + "%\n"
                             + "  - QQQ 5m暴跌: " + qqq5m + "%\n"
                             + "  - RSI超卖点: " + rsi + "\n"
                             + "  - 最小信号数: " + minsig + "\n\n";
        }

        // 智能体验优化：自动将控制台 tab 切换为 “沙盒回测” 并高亮
        const btTabBtn = document.getElementById('console-tab-backtest');
        if (btTabBtn) {
          document.querySelectorAll('.console-tab-btn').forEach(b => b.classList.remove('active'));
          btTabBtn.classList.add('active');
        }

        // 异步调用回测
        fetch('/api/run?task=backtest&years=' + btYears + '&window_days=' + btWindow)
          .then(res => res.json())
          .then(data => {
            try {
              if (data.error) {
                if (terminal) terminal.innerText += "[错误] " + data.error + "\n";
                const errBadge = document.getElementById('current-task-badge');
                if (errBadge) {
                  errBadge.innerText = "ERROR";
                  errBadge.className = "badge badge-red";
                }
                const errDot = document.getElementById('terminal-dot-status');
                if (errDot) errDot.className = "terminal-dot";
              } else {
                startLogPolling('backtest');
              }
            } catch (innerErr) {
              console.error('Error in runBacktestSandbox callback response processing:', innerErr);
            }
          });
      } catch (err) {
        console.error('Error starting backtest sandbox:', err);
      }
    }

    // ── SOP Checkbox and Manual Focus Tickers Helper Functions ──────────────────
    function toggleFocusSymbol(sym, checked) {
      try {
        const url = checked ? '/api/add_focus?symbol=' + sym : '/api/remove_focus?symbol=' + sym;
        fetch(url)
          .then(res => res.json())
          .then(data => {
            if (data.status === 'success') {
              console.log("Focus toggled successfully:", sym, checked);
              updateLiveWatchingTickersUI(sym, checked);
              syncStatus();
            } else {
              console.error("Failed to toggle focus:", data.error);
            }
          })
          .catch(err => console.error("Error toggling focus:", err));
      } catch (err) {
        console.error("Error in toggleFocusSymbol:", err);
      }
    }

    function updateLiveWatchingTickersUI(sym, isAdded) {
      const container = document.getElementById('live-watching-tickers-list');
      if (!container) return;
      const tagId = 'watching-tag-' + sym;
      let tag = document.getElementById(tagId);
      if (isAdded) {
        if (!tag) {
          tag = document.createElement('span');
          tag.id = tagId;
          tag.style = "font-family:'JetBrains Mono'; font-weight:700; color:#cbd5e1; background:rgba(255,255,255,0.05); padding:1px 6px; border-radius:3px; font-size:0.7rem;";
          tag.innerText = sym;
          container.appendChild(tag);
        }
      } else {
        if (tag) {
          tag.remove();
        }
      }
    }

    function addManualFocusStock() {
      try {
        const input = document.getElementById('manual-focus-sym');
        const symbol = input ? input.value.trim().toUpperCase() : '';
        if (!symbol) {
          alert('请输入股票代码！');
          return;
        }
        
        fetch('/api/add_focus?symbol=' + symbol)
          .then(res => res.json())
          .then(data => {
            if (data.status === 'success') {
              if (input) input.value = '';
              
              const container = document.getElementById('focus-checklist-container');
              if (container) {
                const labelId = 'lbl-focus-' + symbol;
                if (!document.getElementById(labelId)) {
                  const label = document.createElement('label');
                  label.id = labelId;
                  label.style = "display:flex; align-items:center; gap:4px; cursor:pointer;";
                  label.className = "focus-chk-lbl";
                  
                  const chk = document.createElement('input');
                  chk.type = "checkbox";
                  chk.checked = true;
                  chk.value = symbol;
                  chk.onchange = function() { toggleFocusSymbol(symbol, this.checked); };
                  
                  const span = document.createElement('span');
                  span.style = "font-family:'JetBrains Mono'; font-weight:700;";
                  span.innerText = symbol;
                  
                  label.appendChild(chk);
                  label.appendChild(span);
                  container.appendChild(label);
                }
              }
              
              updateLiveWatchingTickersUI(symbol, true);
              syncStatus();
              alert(symbol + " 已成功添加到今日关注列表！");
            } else {
              alert("添加失败: " + data.error);
            }
          })
          .catch(err => {
            alert("请求失败: " + err);
          });
      } catch (err) {
        console.error("Error in addManualFocusStock:", err);
      }
    }

    function applyTunedParams() {
      try {
        const btn = document.getElementById('btn-apply-backtest');
        if (btn) {
          btn.disabled = true;
          btn.innerText = "⏳ 正在应用...";
        }
        
        fetch('/api/apply_backtest')
          .then(res => res.json())
          .then(data => {
            if (data.status === 'success') {
              if (btn) {
                btn.style.background = "linear-gradient(135deg, #059669 0%, #047857 100%)";
                btn.innerText = "✓ 已成功应用";
                btn.style.boxShadow = "0 0 10px rgba(16,185,129,0.4)";
              }
              alert("🎉 调优因子参数应用成功！\n" + 
                    "微观参数已成功同步写回，旧参数已备份至 findings 文件夹。\n\n" + 
                    "已应用参数:\n" + JSON.stringify(data.applied_params, null, 2));
              syncStatus();
            } else {
              alert("❌ 应用失败: " + data.error);
              if (btn) {
                btn.disabled = false;
                btn.innerText = "💾 应用参数";
              }
            }
          })
          .catch(err => {
            alert("❌ 请求发送失败: " + err);
            if (btn) {
              btn.disabled = false;
              btn.innerText = "💾 应用参数";
            }
          });
      } catch (err) {
        console.error("Error in applyTunedParams:", err);
      }
    }

    function highlightConsoleTab(taskName) {
      try {
        document.querySelectorAll('.console-tab-btn').forEach(b => {
          b.classList.remove('active');
          if (b.id === 'console-tab-' + taskName) {
            b.classList.add('active');
          }
        });
      } catch (err) {
        console.error("Error highlighting console tab:", err);
      }
    }

    function switchConsoleTab(taskName, btn) {
      try {
        document.querySelectorAll('.console-tab-btn').forEach(b => b.classList.remove('active'));
        if (btn) btn.classList.add('active');
        
        safeStorage.setItem('active_log_task', taskName);
        
        const terminalTitle = document.getElementById('terminal-task-name');
        if (terminalTitle) {
          terminalTitle.innerText = "task_" + taskName + ".log";
        }
        
        fetch('/api/status')
          .then(res => res.json())
          .then(data => {
            const isRunning = !!(data.running_tasks && data.running_tasks[taskName] && data.running_tasks[taskName].running);
            
            const badge = document.getElementById('current-task-badge');
            if (badge) {
              if (isRunning) {
                badge.innerText = "RUNNING";
                badge.className = "badge badge-yellow";
              } else {
                const finished = data.running_tasks && data.running_tasks[taskName] && data.running_tasks[taskName].returncode !== undefined;
                badge.innerText = finished ? "FINISHED" : "IDLE";
                badge.className = finished ? "badge badge-green" : "badge badge-gray";
              }
            }
            
            if (isRunning) {
              startLogPolling(taskName);
            } else {
              if (logPollInterval) {
                clearInterval(logPollInterval);
                logPollInterval = null;
              }
              activeLogPollingTask = null;
              fetchLogsOnce(taskName, false);
            }
          })
          .catch(err => {
            console.error("Error syncing status during tab switch:", err);
            fetchLogsOnce(taskName, false);
          });
      } catch (err) {
        console.error("Error switching console tab:", err);
      }
    }


    function stopTask(taskName) {
      try {
        const terminal = document.getElementById('terminal-body');
        if (terminal) terminal.innerText += "\n[系统] 正在发送终止进程指令...\n";
        
        fetch('/api/stop?task=' + taskName)
          .then(res => res.json())
          .then(data => {
            try {
              if (data.error) {
                if (terminal) terminal.innerText += "[系统] 停止失败: " + data.error + "\n";
              } else {
                if (terminal) terminal.innerText += "[系统] 任务已停止: " + data.message + "\n";
                if (activeLogPollingTask === taskName) {
                  stopLogPolling();
                }
                const badge = document.getElementById('current-task-badge');
                if (badge) {
                  badge.innerText = "STOPPED";
                  badge.className = "badge badge-red";
                }
                syncStatus();
              }
            } catch (innerErr) {
              console.error('Error in stopTask callback response processing:', innerErr);
            }
          });
      } catch (err) {
        console.error('Error stopping task:', err);
      }
    }

    function startLogPolling(taskName) {
      try {
        if (logPollInterval) clearInterval(logPollInterval);
        activeLogPollingTask = taskName;
        // 保持当前活跃日志任务
        safeStorage.setItem('active_log_task', taskName);
        
        // 体验优化：在 1 秒的 Interval 启动前，立即获取一次日志，消除控制台瞬间清空的延迟感
        fetchLogsOnce(taskName, true);
        
        logPollInterval = setInterval(() => {
          fetch('/api/logs?task=' + taskName)
            .then(res => res.json())
            .then(data => {
              try {
                const terminal = document.getElementById('terminal-body');
                if (terminal) {
                  terminal.innerText = data.logs;
                  terminal.scrollTop = terminal.scrollHeight; // 滚动到底部
                }
                const drawerTerminal = document.getElementById('terminal-drawer-body');
                if (drawerTerminal) {
                  drawerTerminal.innerText = data.logs;
                  drawerTerminal.scrollTop = drawerTerminal.scrollHeight;
                }
                
                if (!data.running) {
                  stopLogPolling();
                  if (terminal) {
                    terminal.innerText += "\n[控制台] 进程已退出。\n";
                    terminal.scrollTop = terminal.scrollHeight;
                  }
                  if (drawerTerminal) {
                    drawerTerminal.innerText += "\n[控制台] 进程已退出。\n";
                    drawerTerminal.scrollTop = drawerTerminal.scrollHeight;
                  }
                  syncStatus();
                  
                  // 如果运行的任务是生成报告、预计算或扫描相关任务，进程退出时触发自动重载页面以更新仪表盘
                  const curTask = safeStorage.getItem('active_log_task');
                  if (curTask && (curTask.startsWith('cio_') || curTask === 'premarket' || curTask === 'scan')) {
                    setTimeout(() => {
                      location.reload();
                    }, 1500);
                  }
                }
              } catch (innerErr) {
                console.error('Error in log polling callback:', innerErr);
              }
            })
            .catch(err => {
              console.error('Error fetching logs in interval:', err);
            });
        }, 1000);
      } catch (err) {
        console.error('Error starting log polling:', err);
      }
    }

    function stopLogPolling() {
      try {
        if (logPollInterval) {
          clearInterval(logPollInterval);
          logPollInterval = null;
        }
        activeLogPollingTask = null;
        const dot = document.getElementById('terminal-dot-status');
        if (dot) dot.className = "terminal-dot";
        const drawerDot = document.getElementById('terminal-drawer-dot-status');
        if (drawerDot) drawerDot.className = "terminal-dot";
        
        // 当日志轮询因任务结束而停止时，将 badge 标记为已完成
        const badge = document.getElementById('current-task-badge');
        if (badge && badge.innerText === "RUNNING") {
          badge.innerText = "FINISHED";
          badge.className = "badge badge-green";
        }
      } catch (err) {
        console.error('Error stopping log polling:', err);
      }
    }

    // 单次拉取指定任务的最新日志并回填终端，非阻塞更新 UI 状态
    function fetchLogsOnce(taskName, isRunning) {
      try {
        fetch('/api/logs?task=' + taskName)
          .then(res => res.json())
          .then(data => {
            try {
              const terminal = document.getElementById('terminal-body');
              if (terminal) {
                terminal.innerText = data.logs;
                terminal.scrollTop = terminal.scrollHeight;
              }
              const drawerTerminal = document.getElementById('terminal-drawer-body');
              if (drawerTerminal) {
                drawerTerminal.innerText = data.logs;
                drawerTerminal.scrollTop = drawerTerminal.scrollHeight;
              }
              
              const badge = document.getElementById('current-task-badge');
              const dot = document.getElementById('terminal-dot-status');
              const drawerDot = document.getElementById('terminal-drawer-dot-status');
              const nameEl = document.getElementById('terminal-task-name');
              
              if (nameEl) nameEl.innerText = "task_" + taskName + ".log";
              
              if (badge) {
                if (isRunning) {
                  badge.innerText = "RUNNING";
                  badge.className = "badge badge-yellow";
                  if (dot) dot.className = "terminal-dot active";
                  if (drawerDot) drawerDot.className = "terminal-dot active";
                } else {
                  badge.innerText = "FINISHED";
                  badge.className = "badge badge-green";
                  if (dot) dot.className = "terminal-dot";
                  if (drawerDot) drawerDot.className = "terminal-dot";
                }
              }
            } catch (innerErr) {
              console.error("Error processing fetchLogsOnce data:", innerErr);
            }
          })
          .catch(err => console.error("Error fetching logs once:", err));
      } catch (err) {
        console.error("Error in fetchLogsOnce:", err);
      }
    }

    function clearConsole() {
      try {
        const terminal = document.getElementById('terminal-body');
        if (terminal) {
          terminal.innerText = "=== 控制台内容已清空 ===\n";
        }
      } catch (err) {
        console.error('Error in clearConsole:', err);
      }
    }

    function updateSliderVal(type, val) {
      try {
        const el = document.getElementById('val-' + type);
        if (el) {
          if (type === 'ma200' || type === 'qqq5m') {
            el.innerText = val + '%';
          } else {
            el.innerText = val;
          }
        }
      } catch (err) {
        console.error('Error in updateSliderVal:', err);
      }
    }

    function saveTunedParams() {
      try {
        const vixEl = document.getElementById('slide-vix');
        const ma200El = document.getElementById('slide-ma200');
        const qqq5mEl = document.getElementById('slide-qqq5m');
        const rsiEl = document.getElementById('slide-rsi');
        const minsigEl = document.getElementById('slide-minsig');

        const vix = vixEl ? parseInt(vixEl.value) : 0;
        const ma200 = ma200El ? parseFloat(ma200El.value) : 0.0;
        const qqq5m = qqq5mEl ? parseFloat(qqq5mEl.value) : 0.0;
        const rsi = rsiEl ? parseInt(rsiEl.value) : 0;
        const minsig = minsigEl ? parseInt(minsigEl.value) : 0;

        const payload = {
          macro: {
            vix_panic_threshold: vix,
            ma20_dev_veto_pct: ma200,
            qqq5m_veto: qqq5m
          },
          micro: {
            rsi14_5m_oversold: rsi,
            min_signals_required: minsig
          }
        };

        fetch('/api/save_params', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
        .then(res => res.json())
        .then(data => {
          try {
            const terminal = document.getElementById('terminal-body');
            if (data.status === 'success') {
              if (terminal) terminal.innerText += "\n[系统] 参数保存成功: " + data.message + "\n";
              alert("策略参数已成功应用到本地配置文件！");
            } else {
              if (terminal) terminal.innerText += "\n[错误] 保存参数失败: " + data.error + "\n";
            }
            if (terminal) terminal.scrollTop = terminal.scrollHeight;
          } catch (innerErr) {
            console.error('Error in saveTunedParams response:', innerErr);
          }
        });
      } catch (err) {
        console.error('Error in saveTunedParams:', err);
      }
    }

    function syncStatus() {
      try {
        fetch('/api/status')
          .then(res => res.json())
          .then(data => {
            try {
              // 1. 更新 poll 运行状态指示灯
              const pollActive = data.running_tasks && data.running_tasks.poll && data.running_tasks.poll.running;
              const pollDot = document.getElementById('poll-breathing-dot');
              const btnStart = document.getElementById('btn-poll-start');
              const btnStop = document.getElementById('btn-poll-stop');
              
              if (pollActive) {
                if (pollDot) pollDot.className = "terminal-dot active";
                if (btnStart) {
                  btnStart.style.opacity = "0.5";
                  btnStart.disabled = true;
                }
                if (btnStop) btnStop.disabled = false;
              } else {
                if (pollDot) pollDot.className = "terminal-dot";
                if (btnStart) {
                  btnStart.style.opacity = "1";
                  btnStart.disabled = false;
                }
                if (btnStop) btnStop.disabled = true;
              }

              // 1.5 开发者控制台状态恢复、多任务重连与智能状态自愈
              let activeTask = safeStorage.getItem('active_log_task');
              
              // 智能自愈：如果本地缓存中无当前查看的任务，但后台有正在运行的流水线任务，自动绑定该任务
              if (!activeTask && data.running_tasks) {
                for (const tName in data.running_tasks) {
                  if (data.running_tasks[tName] && data.running_tasks[tName].running) {
                    activeTask = tName;
                    safeStorage.setItem('active_log_task', tName);
                    break;
                  }
                }
              }

              // 智能恢复兜底：如果依然没有活跃任务，使用服务器返回的最近修改日志的那个主要任务
              if (!activeTask && data.latest_log_task) {
                activeTask = data.latest_log_task;
                safeStorage.setItem('active_log_task', activeTask);
              }

              if (activeTask) {
                highlightConsoleTab(activeTask);
                const isRunning = !!(data.running_tasks && data.running_tasks[activeTask] && data.running_tasks[activeTask].running);
                
                if (isRunning) {
                  // 任务正在运行，但前端没有进行实时日志轮询 (可能因为刚刚刷新或切换回 command 页面)
                  if (activeLogPollingTask !== activeTask) {
                    const badge = document.getElementById('current-task-badge');
                    if (badge) {
                      badge.innerText = "RUNNING";
                      badge.className = "badge badge-yellow";
                    }
                    const dot = document.getElementById('terminal-dot-status');
                    if (dot) dot.className = "terminal-dot active";
                    const nameEl = document.getElementById('terminal-task-name');
                    if (nameEl) nameEl.innerText = "task_" + activeTask + ".log";
                    startLogPolling(activeTask);
                  }
                } else {
                  // 任务未运行，且控制台处于初始等待状态或空，单次拉取日志回填以防止信息丢失
                  const terminal = document.getElementById('terminal-body');
                  if (terminal && (terminal.innerText.includes("=== 欢迎来到股票交易指挥中心开发者日志控制台 ===") || terminal.innerText === "")) {
                    fetchLogsOnce(activeTask, false);
                  }
                }
              }

              // 2. 初始化滑块数值（只在滑块未被用户拖拽时更新）
              if (data.params) {
                const macro_params = data.params.macro && data.params.macro.market_regime;
                const micro_params = data.params.micro && data.params.micro.flex_signals;

                if (macro_params && document.activeElement && typeof document.activeElement.id === 'string' && !document.activeElement.id.includes('slide-')) {
                  if (macro_params.vix_panic_threshold) {
                    const vixEl = document.getElementById('slide-vix');
                    if (vixEl) vixEl.value = macro_params.vix_panic_threshold;
                    updateSliderVal('vix', macro_params.vix_panic_threshold);
                  }
                  if (macro_params.ma20_dev_veto_pct) {
                    const ma200El = document.getElementById('slide-ma200');
                    if (ma200El) ma200El.value = macro_params.ma20_dev_veto_pct;
                    updateSliderVal('ma200', macro_params.ma20_dev_veto_pct);
                  }
                  if (macro_params.qqq5m_veto) {
                    const qqq5mEl = document.getElementById('slide-qqq5m');
                    if (qqq5mEl) qqq5mEl.value = macro_params.qqq5m_veto;
                    updateSliderVal('qqq5m', macro_params.qqq5m_veto);
                  }
                }
                if (micro_params && document.activeElement && typeof document.activeElement.id === 'string' && !document.activeElement.id.includes('slide-')) {
                  if (micro_params.rsi14_5m_oversold) {
                    const rsiEl = document.getElementById('slide-rsi');
                    if (rsiEl) rsiEl.value = micro_params.rsi14_5m_oversold;
                    updateSliderVal('rsi', micro_params.rsi14_5m_oversold);
                  }
                  if (micro_params.min_signals_required) {
                    const minsigEl = document.getElementById('slide-minsig');
                    if (minsigEl) minsigEl.value = micro_params.min_signals_required;
                    updateSliderVal('minsig', micro_params.min_signals_required);
                  }
                }
              }

              // 3. 收集并渲染回测 Chart.js
              let baseEV = 0.15; // 默认基准期望
              let optEV = 0.22;
              if (data.portfolio && data.portfolio.totals) {
                baseEV = Math.max(0.05, data.portfolio.totals.total_unrealized_pnl_pct / 100 || baseEV);
              }
              
              if (data.portfolio && data.portfolio.backtest_summary) {
                optEV = data.portfolio.backtest_summary.best_ev || optEV;
              }
              
              drawChart(baseEV, optEV);

              // 4. 更新 yfinance 数据信道健康状态
              if (data.data_health) {
                const badge = document.getElementById('data-health-badge');
                const panel = document.getElementById('data-health-alert-panel');
                const errorsList = document.getElementById('data-health-errors-list');
                
                const isRestricted = data.data_health.status === 'restricted';
                
                if (badge) {
                  if (isRestricted) {
                    badge.className = "badge badge-pulse-red";
                    badge.innerText = "⚠️ 受限";
                  } else {
                    badge.className = "badge badge-green";
                    badge.innerText = "📊 稳定";
                  }
                }
                
                const dismissed = safeStorage.getItem('data_health_panel_dismissed') === 'true';
                if (panel) {
                  if (isRestricted && !dismissed) {
                    panel.style.display = 'block';
                  } else if (!isRestricted) {
                    panel.style.display = 'none';
                  }
                }
                
                if (errorsList && data.data_health.errors) {
                  if (data.data_health.errors.length > 0) {
                    let html = '';
                    data.data_health.errors.forEach(err => {
                      const shortTs = err.ts ? err.ts.substring(11, 19) : '';
                      html += `<div style="margin-bottom:0.3rem;"><span style="color:var(--text-secondary);">[${shortTs}]</span> <span style="color:var(--red); font-weight:bold;">${err.sym}</span>: ${err.msg}</div>`;
                    });
                    errorsList.innerHTML = html;
                  } else {
                    errorsList.innerHTML = '<div style="color:var(--text-muted);">暂无具体错误日志</div>';
                  }
                }
              }

              // 5. 更新每日交易 SOP 引导状态
              if (data.sop_status) {
                // Step 1: 扫描选股
                const dot1 = document.getElementById('sop-step-1-dot');
                const badge1 = document.getElementById('sop-step-1-badge');
                const scanRunning = data.running_tasks && data.running_tasks.scan && data.running_tasks.scan.running;
                const s1 = data.sop_status.step1_scan || {};
                if (dot1 && badge1) {
                  if (scanRunning) {
                    dot1.className = "sop-dot sop-dot-active";
                    badge1.className = "badge badge-blue";
                    badge1.innerText = "⏳ 扫描中...";
                  } else if (s1.done) {
                    dot1.className = "sop-dot sop-dot-green";
                    badge1.className = "badge badge-green";
                    badge1.innerText = s1.detail || "✓ 已完成";
                  } else {
                    dot1.className = "sop-dot";
                    badge1.className = "badge badge-gray";
                    badge1.innerText = s1.detail || "待扫描";
                  }
                }

                // Step 2: 确认关注列表
                const dot2 = document.getElementById('sop-step-2-dot');
                const badge2 = document.getElementById('sop-step-2-badge');
                const s2 = data.sop_status.step2_focus || {};
                if (dot2 && badge2) {
                  if (s2.done) {
                    dot2.className = "sop-dot sop-dot-green";
                    badge2.className = "badge badge-green";
                    badge2.innerText = s2.detail || "✓ 已确认";
                  } else {
                    dot2.className = "sop-dot";
                    badge2.className = "badge badge-gray";
                    badge2.innerText = s2.detail || "待确认";
                  }
                }

                // Step 3: 盘前决策汇总
                const dot3 = document.getElementById('sop-step-3-dot');
                const badge3 = document.getElementById('sop-step-3-badge');
                const pmRunning = data.running_tasks && data.running_tasks.premarket && data.running_tasks.premarket.running;
                const s3 = data.sop_status.step3_premarket || {};
                if (dot3 && badge3) {
                  if (pmRunning) {
                    dot3.className = "sop-dot sop-dot-active";
                    badge3.className = "badge badge-blue";
                    badge3.innerText = "⏳ 决策中...";
                  } else if (s3.done) {
                    dot3.className = "sop-dot sop-dot-green";
                    badge3.className = "badge badge-green";
                    badge3.innerText = s3.detail || "✓ 已完成";
                  } else {
                    dot3.className = "sop-dot";
                    badge3.className = "badge badge-gray";
                    badge3.innerText = s3.detail || "待运行";
                  }
                }

                // Step 4: 盘中高频轮询
                const dot4 = document.getElementById('sop-step-4-dot');
                const badge4 = document.getElementById('sop-step-4-badge');
                const s4 = data.sop_status.step4_poll || {};
                if (dot4 && badge4) {
                  if (s4.done) {
                    dot4.className = "sop-dot sop-dot-active";
                    badge4.className = "badge badge-green";
                    badge4.innerText = s4.detail || "✓ 监测中";
                  } else {
                    dot4.className = "sop-dot";
                    badge4.className = "badge badge-gray";
                    badge4.innerText = s4.detail || "待启动";
                  }
                }

                // Step 5: 盘后复盘
                const dot5 = document.getElementById('sop-step-5-dot');
                const badge5 = document.getElementById('sop-step-5-badge');
                const s5 = data.sop_status.step5_postmarket || {};
                const postRunning = data.running_tasks && data.running_tasks.postmarket && data.running_tasks.postmarket.running;
                if (dot5 && badge5) {
                  if (postRunning) {
                    dot5.className = "sop-dot sop-dot-active";
                    badge5.className = "badge badge-blue";
                    badge5.innerText = "⏳ 复盘中...";
                  } else if (s5.done) {
                    dot5.className = "sop-dot sop-dot-green";
                    badge5.className = "badge badge-green";
                    badge5.innerText = s5.detail || "✓ 已复盘";
                  } else {
                    dot5.className = "sop-dot";
                    badge5.className = "badge badge-gray";
                    badge5.innerText = s5.detail || "待收盘复盘";
                  }
                }
              }

              // 6. 如果有回测结果报告，更新 KPI 网格
              if (data.backtest_report && data.backtest_report.exists) {
                const bt = data.backtest_report;
                const sharpeEl = document.getElementById('kpi-sharpe');
                const mddEl = document.getElementById('kpi-mdd');
                const winrateEl = document.getElementById('kpi-winrate');
                const pfEl = document.getElementById('kpi-pf');
                const alphaEl = document.getElementById('kpi-alpha');
                const applyBtn = document.getElementById('btn-apply-backtest');
                
                if (sharpeEl) sharpeEl.innerText = Number(bt.sharpe).toFixed(2);
                if (mddEl) mddEl.innerText = (Number(bt.mdd) * 100).toFixed(1) + '%';
                if (winrateEl) winrateEl.innerText = (Number(bt.win_rate) * 100).toFixed(1) + '%';
                if (pfEl) pfEl.innerText = Number(bt.profit_factor).toFixed(2);
                if (alphaEl) alphaEl.innerText = (Number(bt.alpha) * 100).toFixed(1) + '%';
                
                if (applyBtn) {
                  applyBtn.style.display = 'block';
                }
              }
            } catch (innerErr) {
              console.error('Error handling syncStatus data:', innerErr);
            }
          });
      } catch (err) {
        console.error('Error in syncStatus:', err);
      }
    }

    function syncStatusWithFeedback(step) {
      try {
        fetch('/api/status')
          .then(function(res) { return res.json(); })
          .then(function(data) {
            syncStatus();  // 先正常更新
            var sop = data.sop_status || {};
            var found = false;
            var msg = '';
            if (step === 'scan') {
              var s1 = sop.step1_scan || {};
              found = s1.done;
              if (found) {
                msg = '✅ ' + (s1.detail || '已完成');
              } else {
                msg = '⚠️ ' + (s1.detail || '未找到扫描报告') + '\n\n→ 服务器工作目录: ' + (data.work_dir || '未知') + '\n→ 期望文件: ' + (data.work_dir || '') + '/candidates_' + (data.system_time || '').slice(0,10) + '.json';
              }
            } else if (step === 'premarket') {
              var s3 = sop.step3_premarket || {};
              found = s3.done;
              if (found) {
                msg = '✅ 盘前决策已完成\n' + (s3.detail || '全部就绪');
              } else {
                msg = '⚠️ 盘前决策未完成\n' + (s3.detail || '待运行') + '\n\n→ 关注列表每只标的需有 premarket_summary 或 memo+macro';
              }
            }
            alert(msg);
          })
          .catch(function(err) {
            alert('状态检查失败: ' + err);
          });
      } catch (err) {
        console.error('Error in syncStatusWithFeedback:', err);
      }
    }

