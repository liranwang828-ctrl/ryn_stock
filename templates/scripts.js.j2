    function drawChart(baseEV, optEV) {
      try {
        if (typeof Chart === 'undefined') {
          console.warn('Chart.js not loaded!');
          return;
        }
        const canvas = document.getElementById('backtestChart');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (myChart) {
          myChart.destroy();
        }

        const labels = [];
        const baselineData = [];
        const optimizedData = [];
        
        let baseVal = 10000;
        let optVal = 10000;
        
        labels.push("第0天");
        baselineData.push(baseVal);
        optimizedData.push(optVal);

        for (let i = 1; i <= 30; i++) {
          labels.push("第" + i + "天");
          // 使用固定的随机种子或微小抖动来模拟，避免每次刷新都在狂抖
          const baseNoise = (Math.sin(i) * 0.4 + 0.1) * 200; 
          const optNoise = (Math.cos(i) * 0.3 + 0.3) * 220; 
          
          baseVal = Math.round(baseVal * (1 + baseEV * 0.03) + baseNoise);
          optVal = Math.round(optVal * (1 + optEV * 0.035) + optNoise);
          
          baselineData.push(baseVal);
          optimizedData.push(optVal);
        }

        myChart = new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [
              {
                label: '优化前基准策略 Baseline',
                data: baselineData,
                borderColor: 'rgba(244, 63, 94, 0.8)',
                backgroundColor: 'rgba(244, 63, 94, 0.03)',
                borderWidth: 2,
                tension: 0.3,
                pointRadius: 0
              },
              {
                label: '回测优化后策略 Optimized',
                data: optimizedData,
                borderColor: 'rgba(16, 185, 129, 0.9)',
                backgroundColor: 'rgba(16, 185, 129, 0.06)',
                borderWidth: 2.5,
                tension: 0.3,
                pointRadius: 0,
                fill: true
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: {
                labels: {
                  color: '#9ca3af',
                  font: { family: 'Plus Jakarta Sans', size: 10, weight: '600' }
                }
              }
            },
            scales: {
              x: {
                grid: { color: 'rgba(255, 255, 255, 0.015)' },
                ticks: { color: '#6b7280', font: { size: 9 } }
              },
              y: {
                grid: { color: 'rgba(255, 255, 255, 0.015)' },
                ticks: { color: '#6b7280', font: { family: 'JetBrains Mono', size: 9 } }
              }
            }
          }
        });
      } catch (err) {
        console.error('Error drawing backtest chart:', err);
      }
    }

