# Multi-Agent Stock Trading Assistant - LLM Configuration Template
# Copy this file to '.env' in the same folder and fill in your actual credentials.
# Note: '.env' is automatically ignored by Git to protect your secrets.

# ==============================================================================
# 1. DeepSeek API 配置 (深度推荐，高性价比，完全兼容 OpenAI API 规范)
# ==============================================================================
LLM_API_TYPE=deepseek
LLM_API_KEY=your_deepseek_api_key_here
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

