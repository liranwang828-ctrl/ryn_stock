{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investing-os.local/schemas/signal-interpretation.schema.json",
  "title": "Investing OS Signal Interpretation Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "version",
    "schema_version",
    "created_at",
    "status",
    "source",
    "signals",
    "degraded_mode"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^signal-interpretation-[0-9]{8}(-[a-z0-9-]+)?$"
    },
    "version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "review_due": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "retired"]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/signal"
      }
    },
    "degraded_mode": {
      "$ref": "#/$defs/degradedMode"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "principles", "generated_by"],
      "properties": {
        "repository": {
          "type": "string"
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PRIN-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "generated_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "signal_type",
        "interpretation",
        "required_context",
        "allowed_outputs",
        "forbidden_outputs",
        "evidence",
        "falsification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "signal_type": {
          "type": "string",
          "enum": ["price", "volume", "vwap", "sector", "news", "earnings", "macro", "position", "attention", "risk"]
        },
        "interpretation": {
          "type": "string"
        },
        "required_context": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["alert", "review_task", "plan_update_candidate", "journal_prompt", "manual_check_required"]
          }
        },
        "forbidden_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimum_confidence": {
          "type": "string",
          "enum": ["low", "medium", "high", "not_applicable"]
        },
        "evidence": {
          "type": "string"
        },
        "falsification": {
          "type": "string"
        },
        "review_notes": {
          "type": "string"
        }
      }
    },
    "degradedMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["if_context_missing", "forbid_new_discretionary_orders", "allowed_actions"],
      "properties": {
        "if_context_missing": {
          "type": "string",
          "enum": ["emit_context_missing_alert", "manual_review_required", "ignore_signal"]
        },
        "forbid_new_discretionary_orders": {
          "type": "boolean",
          "const": true
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

