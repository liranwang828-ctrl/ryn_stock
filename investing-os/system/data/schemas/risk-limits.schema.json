{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investing-os.local/schemas/risk-limits.schema.json",
  "title": "Investing OS Risk Limits Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "version",
    "schema_version",
    "created_at",
    "status",
    "source",
    "limits",
    "degraded_mode"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^risk-limits-[0-9]{8}(-[a-z0-9-]+)?$"
    },
    "version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "review_due": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "retired"]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/limit"
      }
    },
    "degraded_mode": {
      "$ref": "#/$defs/degradedMode"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "principles", "generated_by"],
      "properties": {
        "repository": {
          "type": "string"
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PRIN-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "generated_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope",
        "metric",
        "threshold",
        "unit",
        "enforcement",
        "parameter_status",
        "allowed_actions",
        "forbidden_actions",
        "evidence",
        "falsification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "scope": {
          "type": "string",
          "enum": ["account", "symbol", "position_role", "asset_class", "session", "strategy"]
        },
        "applies_to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "metric": {
          "type": "string"
        },
        "threshold": {
          "oneOf": [
            { "type": "number" },
            { "type": "integer" },
            { "type": "string" },
            { "type": "boolean" }
          ]
        },
        "unit": {
          "type": "string"
        },
        "enforcement": {
          "type": "string",
          "enum": ["monitor_only", "manual_review_required", "hard_block"]
        },
        "parameter_status": {
          "type": "string",
          "enum": ["provisional", "journal_validated", "backtest_validated", "manual_guardrail"]
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "string"
        },
        "falsification": {
          "type": "string"
        },
        "review_notes": {
          "type": "string"
        }
      }
    },
    "degradedMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["if_risk_data_missing", "forbid_new_discretionary_orders", "allowed_actions"],
      "properties": {
        "if_risk_data_missing": {
          "type": "string",
          "enum": ["read_only_alerts", "manual_review_required", "stop_runtime"]
        },
        "forbid_new_discretionary_orders": {
          "type": "boolean",
          "const": true
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

