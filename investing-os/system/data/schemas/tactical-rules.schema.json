{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investing-os.local/schemas/tactical-rules.schema.json",
  "title": "Investing OS Tactical Rules Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "version",
    "schema_version",
    "created_at",
    "status",
    "source",
    "rules",
    "degraded_mode"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^tactical-rules-[0-9]{8}(-[a-z0-9-]+)?$"
    },
    "version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "review_due": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "retired"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "principles", "generated_by"],
      "properties": {
        "repository": {
          "type": "string"
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PRIN-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "generated_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "degraded_mode": {
      "$ref": "#/$defs/degradedMode"
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_principle",
        "discipline_intent",
        "status",
        "parameter_status",
        "parameters",
        "forbidden_actions",
        "evidence",
        "falsification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "source_principle": {
          "type": "string",
          "pattern": "^PRIN-[0-9]{3}$"
        },
        "discipline_intent": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["enabled", "disabled", "monitor_only"]
        },
        "parameter_status": {
          "type": "string",
          "enum": ["provisional", "journal_validated", "backtest_validated", "manual_guardrail"]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              { "type": "number" },
              { "type": "integer" },
              { "type": "string" },
              { "type": "boolean" },
              {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "type": "string" },
                    { "type": "number" },
                    { "type": "integer" },
                    { "type": "boolean" }
                  ]
                }
              }
            ]
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "string"
        },
        "falsification": {
          "type": "string"
        },
        "review_notes": {
          "type": "string"
        }
      }
    },
    "degradedMode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "if_daily_plan_missing",
        "forbid_new_discretionary_orders",
        "allowed_actions"
      ],
      "properties": {
        "if_daily_plan_missing": {
          "type": "string",
          "enum": ["read_only_alerts", "stop_runtime", "manual_review_required"]
        },
        "forbid_new_discretionary_orders": {
          "type": "boolean",
          "const": true
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
