{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investing-os.local/schemas/watchlist-metadata.schema.json",
  "title": "Investing OS Watchlist Metadata Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "version",
    "schema_version",
    "created_at",
    "status",
    "source",
    "symbols",
    "degraded_mode"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^watchlist-metadata-[0-9]{8}(-[a-z0-9-]+)?$"
    },
    "version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "review_due": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "retired"]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/symbol"
      }
    },
    "degraded_mode": {
      "$ref": "#/$defs/degradedMode"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "principles", "generated_by"],
      "properties": {
        "repository": {
          "type": "string"
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PRIN-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "generated_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "role",
        "thesis_status",
        "conviction",
        "allowed_actions",
        "forbidden_actions",
        "triggers",
        "falsification",
        "review_due"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[A-Z0-9.-]{1,12}$"
        },
        "role": {
          "type": "string",
          "enum": ["core_long_term", "swing", "short_term_watch", "research_only", "blocked", "no_trade"]
        },
        "thesis_status": {
          "type": "string",
          "enum": ["active", "draft", "missing", "invalidated", "not_required"]
        },
        "conviction": {
          "type": "string",
          "enum": ["high", "medium", "low", "unknown"]
        },
        "time_horizon": {
          "type": "string",
          "enum": ["intraday", "swing", "long_term", "research"]
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "falsification": {
          "type": "string"
        },
        "risk_notes": {
          "type": "string"
        },
        "source_notes": {
          "type": "string"
        },
        "review_due": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "degradedMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["if_symbol_metadata_missing", "forbid_new_discretionary_orders", "allowed_actions"],
      "properties": {
        "if_symbol_metadata_missing": {
          "type": "string",
          "enum": ["treat_as_no_trade", "manual_review_required", "read_only_alerts"]
        },
        "forbid_new_discretionary_orders": {
          "type": "boolean",
          "const": true
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}

