{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investing-os.local/schemas/degraded-mode.schema.json",
  "title": "Investing OS Degraded Mode Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "version",
    "schema_version",
    "created_at",
    "status",
    "source",
    "modes"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^degraded-mode-[0-9]{8}(-[a-z0-9-]+)?$"
    },
    "version": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "review_due": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "retired"]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mode"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "principles", "generated_by"],
      "properties": {
        "repository": {
          "type": "string"
        },
        "principles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^PRIN-[0-9]{3}$"
          },
          "uniqueItems": true
        },
        "generated_by": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trigger",
        "behavior",
        "forbid_new_discretionary_orders",
        "allowed_actions",
        "forbidden_actions",
        "escalation",
        "evidence",
        "falsification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "trigger": {
          "type": "string"
        },
        "behavior": {
          "type": "string",
          "enum": ["read_only_alerts", "manual_review_required", "stop_runtime", "ignore_signal"]
        },
        "forbid_new_discretionary_orders": {
          "type": "boolean",
          "const": true
        },
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "escalation": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "falsification": {
          "type": "string"
        },
        "review_notes": {
          "type": "string"
        }
      }
    }
  }
}

